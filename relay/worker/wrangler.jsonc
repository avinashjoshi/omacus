{
  // Secrets stay out of this file. Set them per worker:
  //   npx wrangler secret put ACCESS_SECRET
  //   npx wrangler secret put ADMIN_KEY
  // Production uses the same commands with `--env production`.
  // A secret on the test worker is not copied to production.
  // Optional, and only after Cloudflare Access is in front of /admin:
  //   npx wrangler secret put CF_ACCESS_TEAM
  //   npx wrangler secret put CF_ACCESS_AUD
  // The default deploy (no --env) is the test worker.
  "name": "omacus-sync-test",
  "main": "worker.js",
  "compatibility_date": "2026-10-01",
  "workers_dev": true,
  "routes": [{ "pattern": "sync-test.omacus.com", "custom_domain": true }],
  "assets": {
    "directory": "./public",
    "binding": "ASSETS",
    "run_worker_first": true
  },
  "vars": { "SERVE_APP": "1" },
  "durable_objects": { "bindings": [{ "name": "MAILBOXES", "class_name": "Mailboxes" }] },
  "migrations": [{ "tag": "v1", "new_sqlite_classes": ["Mailboxes"] }],
  "env": {
    "production": {
      "name": "omacus-sync",
      "workers_dev": false,
      "routes": [{ "pattern": "sync.omacus.com", "custom_domain": true }],
      "vars": { "SERVE_APP": "0" },
      "durable_objects": { "bindings": [{ "name": "MAILBOXES", "class_name": "Mailboxes" }] },
      "migrations": [{ "tag": "v1", "new_sqlite_classes": ["Mailboxes"] }]
    }
  }
}
