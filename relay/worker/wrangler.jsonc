{
  "name": "omacus-sync-test",
  "main": "worker.js",
  "compatibility_date": "2026-10-01",
  "workers_dev": true,
  "routes": [{ "pattern": "sync-test.omacus.com", "custom_domain": true }],
  "assets": { "directory": "./public", "binding": "ASSETS", "run_worker_first": ["/v1/*"] },
  "durable_objects": { "bindings": [{ "name": "MAILBOXES", "class_name": "Mailboxes" }] },
  "migrations": [{ "tag": "v1", "new_sqlite_classes": ["Mailboxes"] }]
}
