{
  // Secrets stay out of this file. Set them on this worker:
  //   npx wrangler secret put ACCESS_SECRET
  //   npx wrangler secret put ADMIN_KEY
  //   npx wrangler secret put ACCESS_AUD
  // ACCESS_TEAM_DOMAIN is the Access team host. It is not a secret.
  // A bare `npx wrangler deploy` publishes omacus-sync. This file has no
  // other environment, so that command cannot create a second worker.
  "name": "omacus-sync",
  "main": "worker.js",
  "compatibility_date": "2026-10-01",
  "workers_dev": false,
  "routes": [{ "pattern": "sync.omacus.com", "custom_domain": true }],
  "assets": {
    "directory": "./public",
    "binding": "ASSETS",
    "run_worker_first": true
  },
  "vars": {
    "SERVE_APP": "0",
    "ACCESS_TEAM_DOMAIN": "omacus.cloudflareaccess.com",
    "APP_URL": "https://app.omacus.com/"
  },
  "triggers": { "crons": ["15 7 * * *"] },
  "r2_buckets": [{ "binding": "BACKUPS", "bucket_name": "omacus-sync-backups" }],
  // Nights stay until the bucket lifecycle rule deletes them (30 days, prefix nights/).
  "durable_objects": {
    "bindings": [
      { "name": "MAILBOXES", "class_name": "Mailboxes" },
      { "name": "CONFIG", "class_name": "Config" }
    ]
  },
  "migrations": [
    { "tag": "v1", "new_sqlite_classes": ["Mailboxes"] },
    { "tag": "v2", "new_sqlite_classes": ["Config"] }
  ]
}
